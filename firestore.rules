// 這份檔案跟Firebase Console網頁上「Firestore > 規則」頁面的內容要保持一致。
// 以後如果要改規則,建議兩邊同步改(或之後固定只用其中一邊,再用
// `firebase deploy --only firestore:rules` / `firebase firestore:rules:get` 同步)。
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // brands(含子collection drinks):菜單資料,誰都能讀,前端完全不能寫,
    // 只有 scripts/migrate-brands.ts 用Admin SDK寫入(不受這些規則限制)
    match /brands/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // logs:個人飲料紀錄,只能讀寫自己uid的
    match /logs/{logId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.uid;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
      allow update: if request.auth != null
        && request.auth.uid == resource.data.uid
        && request.auth.uid == request.resource.data.uid;
      allow delete: if request.auth != null && request.auth.uid == resource.data.uid;
    }

    // favoriteBrands / favoriteDrinks:大家都能讀(要算「幾個人收藏」給所有人看),
    // 但只能寫自己uid的收藏。update只給拖曳排序用,只能改order欄位,
    // uid不能被換成別人(避免奪取別人的收藏文件)
    match /favoriteBrands/{docId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
      allow update: if request.auth != null
        && request.auth.uid == resource.data.uid
        && request.auth.uid == request.resource.data.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["order"]);
      allow delete: if request.auth != null && request.auth.uid == resource.data.uid;
    }
    match /favoriteDrinks/{docId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
      allow update: if request.auth != null
        && request.auth.uid == resource.data.uid
        && request.auth.uid == request.resource.data.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["order"]);
      allow delete: if request.auth != null && request.auth.uid == resource.data.uid;
    }

    // ratings:大家都能讀(平均分數要給所有人看),只能寫/刪自己uid那筆(可以取消評分)
    match /ratings/{docId} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == request.resource.data.uid;
      allow delete: if request.auth != null && request.auth.uid == resource.data.uid;
    }

    // comments:大家都能讀,登入才能新增,也能編輯/刪除自己的留言
    match /comments/{commentId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
      allow update: if request.auth != null
        && request.auth.uid == resource.data.uid
        && request.auth.uid == request.resource.data.uid;
      allow delete: if request.auth != null && request.auth.uid == resource.data.uid;
    }

    // users:公開的「目前顯示名稱/頭貼」快照。comments原本把displayName存成發文當下的快照,
    // 改名字/換頭貼不會回頭更新舊留言——所以加這個collection,畫面顯示留言者名字/頭像時改成
    // 查這裡目前的值(即時),而不是用留言文件裡存的那份舊快照。
    // 登入/改名字/換頭貼時由lib/user-profile.ts的syncUserProfile同步過來,
    // 只存displayName跟photoURL這兩個欄位。大家都能讀,但只能寫自己的uid,
    // 而且只能寫這兩個欄位,不能夾帶別的資料進來
    match /users/{uid} {
      allow read: if true;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(["displayName", "photoURL"]);
      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["displayName", "photoURL"]);
    }

    // userBadges:只能讀自己解鎖的勳章,前端完全不能寫,
    // 只有Cloud Functions用Admin SDK寫入(不受這些規則限制)
    match /userBadges/{badgeDocId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.uid;
      allow write: if false;
    }

    // menuReports:菜單回報(品牌資訊/價格/更新問題)。一般使用者只能讀/新增自己送出的,
    // 不能自己改內容。管理員(custom claims的admin:true,scripts/set-admin.ts設定的)
    // 可以讀全部回報,也可以更新status/note這兩個欄位(沒照片的回報用來標記核准/拒絕)。
    // 實際改brands資料(套用AI diff、revert)不走這裡,是透過Cloud Function用Admin SDK寫入,
    // 不受這些規則限制,所以這裡不用額外開放aiDiff/appliedChanges的寫入權限
    match /menuReports/{reportId} {
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.uid || request.auth.token.admin == true);
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
      allow update: if request.auth != null
        && request.auth.token.admin == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "note"]);
      allow delete: if false;
    }
  }
}
