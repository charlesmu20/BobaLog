{
  "name": "functions",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && npx firebase-tools emulators:start --only functions,firestore",
    "shell": "npm run build && npx firebase-tools functions:shell",
    "start": "npm run shell",
    "deploy": "npx firebase-tools deploy --only functions",
    "logs": "npx firebase-tools functions:log"
  },
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@google/genai": "^2.31.0",
    "firebase-admin": "^12.6.0",
    "firebase-functions": "^6.0.1"
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  },
  "private": true
}
