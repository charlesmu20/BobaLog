rules_version = '2';

// 這份檔案跟Firebase Console網頁上「Storage > 規則」頁面的內容要保持一致,
// 跟firestore.rules是同一套做法。目前整個專案只有菜單回報功能的照片上傳用到Storage,
// 之後如果有別的功能也要用,再加新的match區塊,不要把這個路徑放寬成什麼都收。
service firebase.storage {
  match /b/{bucket}/o {
    // reportPhotos/{uid}/{fileName}:菜單回報附的照片。讀取開放給所有人——
    // 這些照片是回報用的菜單/價格照片,不是敏感個資,開放讀取可以讓前端直接用
    // getDownloadURL()拿網址存進Firestore,之後管理頁面也能直接顯示,不用另外寫
    // Cloud Function處理。但只有本人能寫進自己uid底下那個資料夾,且限制檔案大小
    // (5MB)跟一定要是圖片類型,避免被亂塞別的檔案進來
    match /reportPhotos/{uid}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // 其他路徑一律鎖死
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
